{
  "manifest_version": 2,
  "name": "AI Translator",
  "version": "1.0.0",
  "description": "Translate selected text using local llama.cpp AI",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-translator@example.com",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": ["lib/shared.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/shared.js", "content.js"]
    }
  ],
  "sidebar_action": {
    "default_title": "AI Translator",
    "default_panel": "popup.html",
    "browser_style": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
